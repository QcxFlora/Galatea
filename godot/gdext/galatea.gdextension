[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.2
reloadable = true

[libraries]
linux.debug.x86_64 = "res://gdext/bin/libgalatea_godot.so"
linux.release.x86_64 = "res://gdext/bin/libgalatea_godot.so"
windows.debug.x86_64 = "res://gdext/bin/galatea_godot.dll"
windows.release.x86_64 = "res://gdext/bin/galatea_godot.dll"
macos.debug = "res://gdext/bin/libgalatea_godot.dylib"
macos.release = "res://gdext/bin/libgalatea_godot.dylib"
android.debug.arm64 = "res://gdext/bin/libgalatea_godot.android.so"
android.release.arm64 = "res://gdext/bin/libgalatea_godot.android.so"
