    {
      "id": "n_ask",
      "next": "n_set",
      "speaker": "xiayu",
      "text": "……明天开始，我就不在这个班了。",
      "type": "say",
      "x": -420,
      "y": 840
    },
    {
      "effects": [
        {
          "expr": "true",
