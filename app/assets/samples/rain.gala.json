      "x": 0,
      "y": 420
    },
    {
      "id": "n_wait",
      "next": "n_choice2",
      "speaker": "xiayu",
      "text": "这个点还没回去？外面的伞大概要卖完了。",
      "type": "say",
      "x": -260,
      "y": 560
    },
    {
      "id": "n_choice2",
      "options": [
        {
          "cond": "aff >= 1",
          "text": "「你有心事？」",
